{
  "title": "ARGUS Traces",
  "uid": "argus-traces",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Recent Traces",
      "type": "table",
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "argus_trace_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum(argus_error_total) / sum(argus_traces_total) * 100",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "P95 Latency",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 12
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(argus_latency_bucket[$__rate_interval])) by (le))",
          "legendFormat": "P95 Latency",
          "refId": "A"
        }
      ]
    }
  ]
}