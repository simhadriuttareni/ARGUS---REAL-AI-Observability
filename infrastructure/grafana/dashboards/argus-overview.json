{
  "title": "ARGUS Overview",
  "uid": "argus-overview",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Total Traces",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(argus_traces_total)",
          "legendFormat": "Traces",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Cost (USD)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(argus_cost_total)",
          "legendFormat": "Cost",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active Alerts",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(argus_alerts_active)",
          "legendFormat": "Alerts",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cache Hit Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(argus_cache_hit_rate)",
          "legendFormat": "Hit Rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latency by Model",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "argus_latency_ms{model=\"$model\"}",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Cost by Provider",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (provider) (argus_cost_total)",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Traces Over Time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "rate(argus_traces_total[$__rate_interval])",
          "legendFormat": "Traces/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Model Comparison",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "argus_cost_total{model=\"$model\"}",
          "legendFormat": "Cost",
          "refId": "A"
        },
        {
          "expr": "argus_latency_ms{model=\"$model\"}",
          "legendFormat": "Latency",
          "refId": "B"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "query": "label_values(argus_cost_total, model)",
        "refresh": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  }
}